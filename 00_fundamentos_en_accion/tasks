#!/usr/bin/env python3
#   Shebang: le dice al sistema operativo que este archivo
#   debe ejecutarse usando Python 3.
#   Gracias a esto puedes usarlo como comando: `tasks --list`

import argparse
#   Módulo estándar para manejar argumentos de línea de comandos
#   (flags como --add, --list, etc.)

import sqlite3
#   Módulo estándar para trabajar con bases de datos SQLite
#   No necesitas instalar nada extra

# Nombre del archivo de base de datos
DB_NAME = "tasks.db"

# Códigos ANSI para colorear la salida en terminal
GREEN = "\033[92m"   # Verde → éxito
RED = "\033[91m"     # Rojo → error / eliminación
YELLOW = "\033[93m"  # Amarillo → advertencias
RESET = "\033[0m"    # Reset → vuelve al color normal

def get_connection():
    """
    Crea y devuelve una conexión a la base de datos SQLite.
    Cada llamada abre una nueva conexión.
    """
    return sqlite3.connect(DB_NAME)

def init_db():
    """
    Inicializa la base de datos.
    Crea la tabla 'tasks' si no existe.
    Se ejecuta cada vez que arranca el programa,
    pero SQLite solo la crea una vez.
    """
    conn = get_connection()      # Abrimos conexión
    cursor = conn.cursor()      # Creamos un cursor (ejecutor de SQL)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            description TEXT NOT NULL
        )
    """)
    #   SQL real:
    # - id: número único automático
    # - description: texto obligatorio

    conn.commit()               # Guardamos cambios
    conn.close()                # Cerramos conexión (muy importante)

def list_tasks():
    """
    Muestra todas las tareas almacenadas en la base de datos.
    """
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("SELECT id, description FROM tasks")
    #   Consulta SQL: trae todas las tareas

    rows = cursor.fetchall()
    #   Convierte el resultado en una lista de tuplas:
    #   [(id, description), (id, description), ...]

    conn.close()

    if not rows:
        # Si no hay resultados
        print(f"{YELLOW}No hay tareas.{RESET}")
    else:
        # Recorremos cada fila
        for task_id, desc in rows:
            # task_id → id de la tarea
            # desc    → descripción
            print(f"{GREEN}{task_id}.{RESET} {desc}")

def add_task(description):
    """
    Agrega una nueva tarea a la base de datos.
    """
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute(
        "INSERT INTO tasks (description) VALUES (?)",
        (description,)
    )
    #   Uso de parámetros (?) evita inyección SQL
    #   MUY importante para seguridad

    conn.commit()
    conn.close()

    print(f"{GREEN}Tarea agregada.{RESET}")

def delete_task(task_id):
    """
    Elimina una tarea por su ID.
    """
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute(
        "DELETE FROM tasks WHERE id = ?",
        (task_id,)
    )
    #   Borra la tarea cuyo id coincide

    if cursor.rowcount == 0:
        # Si no se borró ninguna fila
        print(f"{RED}ID inválido.{RESET}")
    else:
        print(f"{RED}Tarea eliminada.{RESET}")

    conn.commit()
    conn.close()

def update_task(task_id, new_description):
    """
    Actualiza el texto de una tarea existente.
    """
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute(
        "UPDATE tasks SET description = ? WHERE id = ?",
        (new_description, task_id)
    )

    if cursor.rowcount == 0:
        print(f"{RED}ID inválido. Nada fue actualizado.{RESET}")
    else:
        print(f"{GREEN}Tarea actualizada.{RESET}")

    conn.commit()
    conn.close()

def main():
    """
    Punto de entrada principal del programa.
    Coordina base de datos, argumentos y acciones.
    """
    init_db()
    #   Asegura que la base de datos y la tabla existan

    parser = argparse.ArgumentParser(
        description="Gestor de tareas con SQLite"
    )
    #   Define el programa y su descripción

    parser.add_argument("--list", action="store_true")
    #   Flag booleano: si aparece --list → True

    parser.add_argument("--add", type=str)
    #   Flag que recibe un texto:
    #   --add "Nueva tarea"

    parser.add_argument("--delete", type=int)
    #   Flag que recibe un número:
    #   --delete 3
    
    parser.add_argument(
    "--update",
    nargs=2,
    metavar=("ID", "TEXTO"),
    help="Actualiza una tarea existente"
    )

    args = parser.parse_args()
    #   Procesa los argumentos escritos en la terminal

    # Lógica principal:
    if args.list:
        list_tasks()
    elif args.add:
        add_task(args.add)
    elif args.delete:
        delete_task(args.delete)
    elif args.update:
        task_id = int(args.update[0])
        new_text = args.update[1]
        update_task(task_id, new_text)
    else:
        parser.print_help()
        #   Si no se pasó ningún argumento, muestra ayuda

if __name__ == "__main__":
    main()
    #   Garantiza que main() solo se ejecute
    #   cuando este archivo se corre directamente,
    #   no cuando se importa como módulo
